# =============================================================================
# api-app — API do estoque (porta 8810)
# =============================================================================
# Copie para .env e preencha. NUNCA versione o .env.
# Toda variável sem valor abaixo é OBRIGATÓRIA para o serviço subir.
# =============================================================================

# --- Execução --------------------------------------------------------------
# MODE: development | production | test. Controla log e o guard de testes.
MODE=development
# AMBIENTE: rótulo livre usado em log/monitoramento (local, staging, producao).
AMBIENTE=local
PORT=8810
# GIT_SHA: hash do commit publicado. O deploy injeta; em local pode ficar vazio.
GIT_SHA=
# Origem exata do frontend, para o CORS. Em local o default já cobre
# localhost:8800; em produção é OBRIGATÓRIO apontar pro domínio real.
FRONTEND_URL=http://localhost:8800

# --- Banco de dados (Firestore) ---------------------------------------------
# Project ID do Firebase (console.firebase.google.com/project/SEU-ID).
FIREBASE_PROJECT_ID=eng-ci
# Em desenvolvimento local, aponta o Admin SDK pro Firestore Emulator em vez
# do Firestore real. Suba o emulador com `npx firebase-tools emulators:start
# --only firestore` (a partir de backend/). Deixe VAZIO em produção — lá o SDK
# usa o Firestore real sozinho, via credenciais do ambiente.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Segredos de autenticação ----------------------------------------------
# Gere cada um com: openssl rand -hex 32
# BCRYPT_KEY: pepper do hash de senha. Trocar INVALIDA todas as senhas.
BCRYPT_KEY=
# TOKEN_USUARIO: segredo de assinatura do JWT de sessão.
TOKEN_USUARIO=

# --- Monitoramento de erros (opcional) -------------------------------------
# Sem SENTRY_DSN o Sentry nem inicializa — em desenvolvimento deixe vazio.
SENTRY_DSN=
# NODE_ENV decide se os eventos são enviados: só "production" reporta.
# Quem faz o deploy é quem define; em local deixe vazio ou "development".
NODE_ENV=development
